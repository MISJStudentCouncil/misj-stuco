{
  "name": "MISJ StuCo website",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "postStartCommand": "nohup python3 -m http.server 8000 >/dev/null 2>&1 &",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "StuCo site", "onAutoForward": "openPreview" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ritwickdey.LiveServer"],
      "settings": { "editor.formatOnSave": false }
    }
  }
}
